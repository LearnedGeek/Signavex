<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Signavex.Jobs</RootNamespace>
    <AssemblyName>Signavex.Jobs</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Signavex.Domain\Signavex.Domain.csproj" />
    <ProjectReference Include="..\Signavex.Engine\Signavex.Engine.csproj" />
    <ProjectReference Include="..\Signavex.Infrastructure\Signavex.Infrastructure.csproj" />
    <ProjectReference Include="..\Signavex.Signals\Signavex.Signals.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.3" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="9.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- appsettings.json is for local-dev `dotnet run` of Signavex.Jobs. In
         production the box has /var/www/signavex/appsettings.json from Web's
         publish (Signavex.Jobs.dll lives in the same directory and inherits
         it). CopyToPublishDirectory=Never avoids NETSDK1152 conflict when
         Web's publish step transitively pulls this project. -->
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
  </ItemGroup>

</Project>
