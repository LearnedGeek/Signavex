@* Small KPI card. Tone is "good" | "bad" | "neutral" — controls value color only. *@

<div class="rounded-[var(--radius-md)] border border-outline-variant bg-surface-container-lowest p-3">
    <p class="text-[10px] uppercase tracking-wider text-on-surface-variant font-medium">@Label</p>
    <p class="text-lg font-bold mt-1 @ColorClass">@Value</p>
</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter, EditorRequired] public string Value { get; set; } = "";
    [Parameter] public string Tone { get; set; } = "neutral";

    private string ColorClass => Tone switch
    {
        "good" => "text-success",
        "bad" => "text-error",
        _ => "text-on-surface"
    };
}
