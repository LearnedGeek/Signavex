@page "/picks"
@attribute [Authorize]
@using Signavex.Domain.Configuration
@using Signavex.Domain.Enums
@using Signavex.Domain.Helpers
@using Signavex.Domain.Models
@using Signavex.Web.Services
@using Microsoft.Extensions.Options
@inject ScanDashboardService DashboardService
@inject ApiKeyValidationService ApiKeyService
@inject IOptions<SignavexOptions> Options
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Stock Picks — Signavex</PageTitle>

<div class="animate-fade-in">
    @* Header *@
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between mb-6">
        <div>
            <h1 class="text-2xl font-bold text-on-surface tracking-tight">Stock Picks</h1>
            <p class="text-sm text-on-surface-variant mt-0.5">Stocks our system flagged as interesting today</p>
            @if (_lastScanTime.HasValue)
            {
                <p class="text-xs text-on-surface-variant">
                    Updated @RelativeTime(_lastScanTime.Value)
                    @if (_lastScanErrors > 0)
                    {
                        <span class="text-warning"> · @_lastScanErrors stocks had incomplete data</span>
                    }
                </p>
            }
            @if (_scanStatus?.IsScanning == true)
            {
                <p class="text-xs text-primary mt-0.5">
                    Updating · @_scanStatus.Evaluated of @_scanStatus.Total stocks checked · refresh to see new results
                </p>
            }
        </div>
        <div class="flex items-center gap-2">
            @if (_filteredResults.Count > 0)
            {
                <a href="/picks/export.csv"
                   class="inline-flex items-center gap-1.5 rounded-[var(--radius-sm)] border border-outline px-3 py-2 text-sm font-medium text-on-surface-variant transition-colors hover:bg-surface-container no-underline">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
                    </svg>
                    Export CSV
                </a>
            }
        </div>
    </div>

    @* API Key Warning *@
    @if (!ApiKeyService.HasAllKeys)
    {
        var missing = ApiKeyService.GetMissingKeys();
        <div class="mb-4 flex items-start gap-3 rounded-[var(--radius-md)] border border-warning/30 bg-warning-container/30 p-4">
            <svg class="h-5 w-5 shrink-0 text-warning mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
            </svg>
            <div>
                <p class="text-sm font-medium text-on-surface">API keys not configured</p>
                <p class="text-sm text-on-surface-variant mt-0.5">
                    Missing: @string.Join(", ", missing).
                    Scans will fail or return incomplete data. Configure keys in
                    <a href="/settings" class="text-primary font-medium hover:underline">Settings</a>.
                </p>
            </div>
        </div>
    }

    @* Market Context *@
    <MarketContextBar Context="_marketContext" />

    @* Results *@
    @if (_filteredResults.Count == 0)
    {
        @if (_lastScanTime.HasValue && _marketContext is not null)
        {
            @* Scan completed with 0 candidates — show rich summary *@
            <div class="rounded-[var(--radius-md)] border border-outline-variant bg-surface-container-lowest p-5">
                <h3 class="text-base font-semibold text-on-surface mb-4">Latest Results</h3>

                @* Stats row *@
                <div class="grid grid-cols-3 gap-4 mb-4">
                    <div class="rounded-[var(--radius-sm)] bg-surface-container p-3 text-center">
                        <p class="text-2xl font-bold text-on-surface">@_totalEvaluated.ToString("N0")</p>
                        <p class="text-xs text-on-surface-variant mt-0.5">Stocks Checked</p>
                    </div>
                    <div class="rounded-[var(--radius-sm)] bg-surface-container p-3 text-center">
                        <p class="text-2xl font-bold text-on-surface">0</p>
                        <p class="text-xs text-on-surface-variant mt-0.5">Picks Found</p>
                    </div>
                    <div class="rounded-[var(--radius-sm)] bg-surface-container p-3 text-center">
                        <p class="text-2xl font-bold @(_marketContext.Multiplier >= 1.0 ? "text-success" : "text-warning")">
                            @_marketContext.Multiplier.ToString("F2")x
                        </p>
                        <p class="text-xs text-on-surface-variant mt-0.5">Market Mood</p>
                    </div>
                </div>

                @* Educational explanation *@
                <div class="rounded-[var(--radius-sm)] border border-outline-variant/50 bg-surface-container/50 p-3">
                    <p class="text-sm font-medium text-on-surface mb-1">Why no picks today?</p>
                    <p class="text-sm text-on-surface-variant leading-relaxed">
                        @MarketExplanation()
                    </p>
                </div>
            </div>
        }
        else
        {
            <div class="flex flex-col items-center justify-center py-16 text-center">
                <div class="flex h-16 w-16 items-center justify-center rounded-[var(--radius-lg)] bg-surface-container mb-4">
                    <svg class="h-8 w-8 text-on-surface-variant" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" />
                    </svg>
                </div>
                <h3 class="text-base font-semibold text-on-surface">No stock picks yet</h3>
                <p class="mt-1 text-sm text-on-surface-variant max-w-sm">
                    Stock picks appear here after each daily analysis. Check back after the next update.
                </p>
            </div>
        }
    }
    else
    {
        @* Filter chips — links with query strings *@
        <div class="flex flex-wrap items-center gap-2 mb-4">
            <a href="@BuildHref(tier: "")" class="@ChipCss(string.IsNullOrEmpty(Tier))">All Tiers</a>
            <a href="@BuildHref(tier: "SP500")" class="@ChipCss(Tier == "SP500")">S&amp;P 500</a>
            <a href="@BuildHref(tier: "SP400")" class="@ChipCss(Tier == "SP400")">S&amp;P 400</a>
            <a href="@BuildHref(tier: "SP600")" class="@ChipCss(Tier == "SP600")">S&amp;P 600</a>

            <span class="mx-1 h-4 w-px bg-outline-variant"></span>

            <a href="@BuildHref(sort: "score")" class="@ChipCss(string.IsNullOrEmpty(Sort) || Sort == "score")">By Score</a>
            <a href="@BuildHref(sort: "ticker")" class="@ChipCss(Sort == "ticker")">A-Z</a>
            <a href="@BuildHref(sort: "raw")" class="@ChipCss(Sort == "raw")">Base Score</a>
        </div>

        @* Candidate cards *@
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            @foreach (var candidate in _filteredResults)
            {
                <a href="/picks/@candidate.Ticker"
                   class="group rounded-[var(--radius-md)] border border-outline-variant bg-surface-container-lowest p-4 shadow-elevation-1 transition-all duration-150 hover:shadow-elevation-2 hover:border-primary/30 no-underline">
                    <div class="flex items-start justify-between mb-2">
                        <div>
                            <span class="text-base font-bold text-on-surface">@candidate.Ticker</span>
                            <p class="text-xs text-on-surface-variant mt-0.5 truncate max-w-[150px]">@candidate.CompanyName</p>
                        </div>
                        <ScoreBadge Score="candidate.FinalScore" />
                    </div>
                    <div class="flex items-center gap-3 text-xs text-on-surface-variant">
                        <span class="rounded-[var(--radius-xs)] bg-surface-container px-1.5 py-0.5 font-medium">@candidate.Tier</span>
                        <span>Base: @candidate.RawScore.ToString("F3")</span>
                        <span>@candidate.SignalResults.Count(s => s.IsAvailable) signals</span>
                    </div>
                </a>
            }
        </div>

        <p class="mt-3 text-xs text-on-surface-variant">
            Showing @_filteredResults.Count of @_displayCount stock picks
        </p>

        @* Agent export — top high-conviction picks formatted for a Public.com
           AI trading agent (or similar). Static SSR, so the Copy button uses
           a vanilla inline JS onclick — no Blazor interactivity required. *@
        @if (_isPro && _agentExportLines.Count > 0)
        {
            <div class="mt-6 rounded-[var(--radius-md)] border border-outline-variant bg-surface-container-lowest p-4">
                <div class="flex items-center justify-between mb-3 gap-3">
                    <div>
                        <h2 class="text-sm font-semibold text-on-surface m-0">Copy for AI Trading Agent</h2>
                        <p class="text-xs text-on-surface-variant mt-0.5 m-0">
                            Top @_agentExportLines.Count picks scoring @AgentExportThreshold.ToString("F2")+ · @AgentExportHorizonDays-day horizon · paste into Public.com or similar.
                        </p>
                    </div>
                    <button type="button"
                            onclick="navigator.clipboard.writeText(document.getElementById('agent-export-text').innerText).then(()=>{this.innerText='Copied';setTimeout(()=>this.innerText='Copy',1500);})"
                            class="shrink-0 rounded-[var(--radius-sm)] border border-outline px-3 py-1.5 text-xs font-medium text-on-surface-variant hover:bg-surface-container">
                        Copy
                    </button>
                </div>
                <pre id="agent-export-text" class="rounded-[var(--radius-sm)] bg-surface-container p-3 text-xs font-mono text-on-surface overflow-x-auto whitespace-pre m-0">@string.Join("\n", _agentExportLines)</pre>
            </div>
        }

        @if (!_isPro && _displayCount > 5)
        {
            <div class="mt-4">
                <UpgradePrompt Title="@($"See All {_displayCount} Stock Picks")"
                               Description="You're seeing the top 5 picks. Upgrade to see the full list." />
            </div>
        }
    }
</div>

<Disclaimer />

@code {
    [SupplyParameterFromQuery(Name = "tier")]
    public string? Tier { get; set; }

    [SupplyParameterFromQuery(Name = "sort")]
    public string? Sort { get; set; }

    private ScanStatus? _scanStatus;
    private MarketContext? _marketContext;
    private List<StockCandidate> _filteredResults = new();
    private int _displayCount;
    private DateTime? _lastScanTime;
    private int _lastScanErrors;
    private int _totalEvaluated;
    private bool _isPro;

    // Agent-export config. Threshold is higher than the surfacing cutoff
    // (0.45) because for real money you want conviction, not just "above
    // the bar." Horizon defaults to 90d — the median of our 30/90/180/365
    // forward-test windows. Held as consts for now; promote to config
    // once we have data showing different values produce better outcomes.
    private const double AgentExportThreshold = 0.55;
    private const int AgentExportMaxPicks = 5;
    private const int AgentExportHorizonDays = 90;
    private List<string> _agentExportLines = new();

    protected override async Task OnParametersSetAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _isPro = authState.User.IsInRole("Pro") || authState.User.IsInRole("Admin");

        // Load latest result
        try
        {
            var result = await DashboardService.GetLatestResultAsync();
            if (result is not null)
            {
                _marketContext = result.MarketContext;
                _lastScanTime = result.CompletedAtUtc;
                _lastScanErrors = result.ErrorCount;
                _totalEvaluated = result.TotalEvaluated;

                // Agent export lines — computed from the raw candidate set
                // so they reflect the top high-conviction picks regardless of
                // the UI's tier/sort filters.
                _agentExportLines = result.Candidates
                    .Where(c => c.FinalScore >= AgentExportThreshold)
                    .OrderByDescending(c => c.FinalScore)
                    .Take(AgentExportMaxPicks)
                    .Select(c => $"{c.Ticker} | score {c.FinalScore:F2} | horizon {AgentExportHorizonDays}d")
                    .ToList();

                var threshold = Options.Value.SurfacingThreshold;
                IEnumerable<StockCandidate> filtered = result.Candidates
                    .Where(c => c.FinalScore >= threshold);

                if (!string.IsNullOrEmpty(Tier) && Enum.TryParse<MarketTier>(Tier, out var tier))
                    filtered = filtered.Where(c => c.Tier == tier);

                filtered = Sort switch
                {
                    "ticker" => filtered.OrderBy(c => c.Ticker),
                    "raw" => filtered.OrderByDescending(c => c.RawScore),
                    _ => filtered.OrderByDescending(c => c.FinalScore)
                };

                _displayCount = filtered.Count();

                if (!_isPro)
                    filtered = filtered.Take(5);

                _filteredResults = filtered.ToList();
            }
        }
        catch
        {
            // Persist layer unavailable
        }

        // Get scan status (one-shot, no polling)
        try
        {
            _scanStatus = await DashboardService.GetScanStatusAsync();
        }
        catch
        {
            // Status unavailable
        }
    }

    private string BuildHref(string? tier = null, string? sort = null)
    {
        var t = tier ?? Tier;
        var s = sort ?? Sort;
        var parts = new List<string>();
        if (!string.IsNullOrEmpty(t))
            parts.Add($"tier={Uri.EscapeDataString(t)}");
        if (!string.IsNullOrEmpty(s))
            parts.Add($"sort={Uri.EscapeDataString(s)}");
        return parts.Count > 0 ? "/picks?" + string.Join("&", parts) : "/picks";
    }

    private static string RelativeTime(DateTime utcTime)
    {
        var elapsed = DateTime.UtcNow - utcTime;
        if (elapsed.TotalMinutes < 1) return "just now";
        if (elapsed.TotalMinutes < 60) return $"{(int)elapsed.TotalMinutes}m ago";
        if (elapsed.TotalHours < 24) return $"{(int)elapsed.TotalHours}h ago";
        return $"{(int)elapsed.TotalDays}d ago";
    }

    private static string ChipCss(bool active) => active
        ? "rounded-[var(--radius-sm)] bg-primary text-on-primary px-3 py-1.5 text-xs font-medium transition-colors no-underline"
        : "rounded-[var(--radius-sm)] bg-surface-container text-on-surface-variant px-3 py-1.5 text-xs font-medium transition-colors hover:bg-surface-container-high no-underline";

    private string MarketExplanation()
    {
        var mult = _marketContext!.Multiplier;

        if (mult < 0.7)
            return "The overall market is under significant pressure right now. " +
                   "Our system adjusts for market conditions — when the market is this weak, stocks need to be " +
                   "exceptionally strong on their own to make the cut. Even solid companies can fall short when " +
                   "the broader market is dragging everything down.";

        if (mult < 0.9)
            return "Market conditions are challenging right now. Our system raises the bar during tough markets, " +
                   "so fewer stocks qualify. This is by design — it keeps the picks list focused on stocks " +
                   "that are strong enough to stand out even in a difficult environment.";

        if (mult < 1.0)
            return "The market is slightly cautious right now. A small headwind from overall market conditions " +
                   "can push borderline stocks just below the cutoff. When the market improves, " +
                   "these stocks may start appearing.";

        return "Market conditions are favorable, but no individual stocks scored high enough across our signals " +
               "(price trends, volume, fundamentals) to make today's picks list. " +
               "This can happen when stock-level indicators are mixed or weak across the board.";
    }
}
